if BOARD_NRF52840_MDK_USB_DONGLE

# The board's UF2 and settings defaults are supplied by the user config.
config ZMK_BOARD_COMPAT
	default y

endif

if SHIELD_SWEEP_DONGLE

config ZMK_KEYBOARD_NAME
	default "Sweep"

config ZMK_SPLIT_ROLE_CENTRAL
	default y

config ZMK_USB
	default y

endif

if SHIELD_SWEEP_LEFT

config ZMK_SPLIT_ROLE_CENTRAL
	default y

endif

if SHIELD_SWEEP_LEFT || SHIELD_SWEEP_RIGHT || SHIELD_SWEEP_DONGLE

config ZMK_SPLIT
	default y

config ZMK_BLE
	default y

endif
